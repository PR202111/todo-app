# TodoFlow 2.0 Environment Configuration
# Copy this file to .env before starting production deployments:
#   cp .env.example .env

# Security: Set a strong random secret key for JWT authentication tokens in production
SECRET_KEY=change_this_to_a_secure_random_hex_or_string_in_production

# Networking & Ports
FRONTEND_PORT=8080
BACKEND_PORT=8000

# CORS Origins (comma-separated list of allowed browser origins)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Database configuration (defaults to SQLite persistent container volume)
DATABASE_URL=sqlite:////app/data/todoapp.db
